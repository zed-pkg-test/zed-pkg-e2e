{
  "schemaVersion": "opto-sync.adoption.v1",
  "project": "sonus-auris/sonus-auris-clients",
  "clientPackage": {
    "package": "opto-sync/opto-sync-clients",
    "repository": "https://github.com/opto-sync/opto-sync-clients",
    "version": "0.2.0",
    "commit": "068414c8ff7d4262d0a395959b5209d5908f0fcc"
  },
  "languages": [
    "dart",
    "gleam",
    "rust",
    "typescript"
  ],
  "dataScopes": [
    "recordingMetadata",
    "retentionPolicies",
    "schedule",
    "syncCheckpoints"
  ],
  "localStores": [
    "indexeddb",
    "sqlite"
  ],
  "transports": [
    "http",
    "supabase-realtime",
    "websocket"
  ],
  "writeStrategies": [
    "local-durable",
    "local-then-remote",
    "remote-confirmed"
  ],
  "conflictPolicy": {
    "arrayStrategy": "mergeByKey",
    "resolveByTimestamp": true,
    "lwwKeys": [
      "updatedAt"
    ],
    "arrayMatchKeys": [
      "id"
    ],
    "tombstones": true
  },
  "background": {
    "webServiceWorker": true,
    "mobileWorker": true,
    "desktopWorker": true
  },
  "security": {
    "authenticatedTransport": true,
    "encryptedAtRest": true,
    "secretsInManifest": false
  },
  "rollout": {
    "phase": "declared",
    "owners": [
      "sonus-auris"
    ]
  },
  "notes": "Sync recording metadata, schedules, retention policy, upload state, and causal checkpoints only. Raw audio, plaintext recordings, encryption keys, recovery material, device capabilities, and access or refresh tokens remain outside Opto Sync."
}
