define actor Counter as
    state {
        count: int = 0;
    }

    pub increment(): int using state.read, state.write {
        return self.handle_state(critical |s| -> {
            s.count = s.count + 1;
            return s.count;
        });
    }

    receive(ActorMail<String> mail): void {
        val next = self.increment();
        stdio.println(next);
        if (next == 3) {
            self.end();
        } fi
        return;
    }
end

pub async routine main(): void {
    val worker = spawn Counter();
    await worker.ready;
    worker.send("first");
    worker.send("second");
    worker.send("third");
    await worker.done;
    return;
}
