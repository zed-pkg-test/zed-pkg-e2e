define actor Counter as
    state { count: int = 0; }

    pub increment(): int using state.read, state.write {
        return self.handle_state(critical |s| -> {
            s.count = s.count + 1;
            return s.count;
        });
    }

    pub read(): int using state.read {
        return self.handle_state(critical |s| -> s.count);
    }
end
