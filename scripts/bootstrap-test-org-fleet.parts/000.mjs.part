#!/usr/bin/env node
// generated by zed-pkg-test/test-org-fleet
// Idempotently creates the test-repository fleet, seeds generated harnesses,
// pins source repositories, creates real gitlinks for submodule lanes, and opens draft PRs.
import fs from 'node:fs';
import path from 'node:path';
import process from 'node:process';
import zlib from 'node:zlib';

const CHECKOUT_SHA = '3d3c42e5aac5ba805825da76410c181273ba90b1'; // actions/checkout v7.0.1
const REPO_ROOT = path.resolve(process.env.TEST_ORG_FLEET_REPO_ROOT || process.cwd());

function parseArgs(argv) {
  const result = { apply: false, orgs: [], repos: [], concurrency: 4, summaryJson: false, manifest: path.join(REPO_ROOT, 'bootstrap', 'test-org-fleet.json.gz') };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--apply') result.apply = true;
    else if (arg === '--dry-run') result.apply = false;
    else if (arg === '--summary-json') result.summaryJson = true;
    else if (arg === '--org') result.orgs.push(argv[++index]);
    else if (arg === '--repo') result.repos.push(argv[++index]);
    else if (arg === '--concurrency') result.concurrency = Number(argv[++index]);
    else if (arg === '--manifest') result.manifest = path.resolve(argv[++index]);
    else if (arg === '--help' || arg === '-h') {
      console.log(`Usage: node scripts/bootstrap-test-org-fleet.mjs [options]\n\n` +
        `  --dry-run                 Print the plan (default)\n` +
        `  --apply                   Create/update repos, commits, and draft PRs\n` +
        `  --org <test-org>          Limit to a test org (repeatable)\n` +
        `  --repo <glob>             Limit repository names (repeatable)\n` +
        `  --concurrency <n>         Parallel org workers (default: 4)\n` +
        `  --manifest <path>         Alternate manifest path\n` +
        `  --summary-json            Emit machine-readable summary\n`);
      process.exit(0);
    } else throw new Error(`unknown argument: ${arg}`);
  }
  if (!Number.isInteger(result.concurrency) || result.concurrency < 1 || result.concurrency > 12) throw new Error('--concurrency must be an integer from 1 to 12');
  return result;
}

const options = parseArgs(process.argv.slice(2));
function readManifestBytes(manifestPath) {
  if (fs.existsSync(manifestPath)) return fs.readFileSync(manifestPath);
  const partsDir = `${manifestPath}.b64.parts`;
  if (!fs.existsSync(partsDir)) throw new Error(`manifest not found: ${manifestPath}`);
  const encoded = fs.readdirSync(partsDir).sort().map((name) => fs.readFileSync(path.join(partsDir, name), 'utf8').trim()).join('');
  return Buffer.from(encoded, 'base64');
}
const manifestBytes = readManifestBytes(options.manifest);
const manifest = JSON.parse((options.manifest.endsWith('.gz') ? zlib.gunzipSync(manifestBytes) : manifestBytes).toString('utf8'));
const excluded = new Set(manifest.policy.excludedOrganizations ?? []);
const token = process.env.GH_TOKEN || process.env.GITHUB_TOKEN;
const apiBase = process.env.GITHUB_API_URL || 'https://api.github.com';
const sourceCache = new Map();
const stats = { planned: 0, created: 0, existing: 0, gated: 0, committed: 0, noChange: 0, pullRequests: 0, errors: 0 };

if (options.apply && !token) throw new Error('GH_TOKEN (or GITHUB_TOKEN) is required with --apply');
if (options.apply && manifest.schemaVersion !== 1) throw new Error(`unsupported schemaVersion ${manifest.schemaVersion}`);

function log(message, context = {}) {
  if (options.summaryJson) return;
  const prefix = options.apply ? 'apply' : 'plan';
  const suffix = Object.keys(context).length ? ` ${JSON.stringify(context)}` : '';
  console.log(`[${prefix}] ${message}${suffix}`);
}

function route(value) {
  return value.split('/').map(encodeURIComponent).join('/');
}

async function api(method, endpoint, body, { allow404 = false } = {}) {
  const url = `${apiBase}${endpoint}`;
  for (let attempt = 0; attempt < 5; attempt += 1) {
    const response = await fetch(url, {
      method,
      headers: {
        Accept: 'application/vnd.github+json',
        Authorization: `Bearer ${token}`,
        'X-GitHub-Api-Version': '2022-11-28',
        'User-Agent': 'zed-pkg-test-fleet-bootstrap/1',
        ...(body === undefined ? {} : { 'Content-Type': 'application/json' }),
      },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    if (allow404 && response.status === 404) return null;
    if (response.ok) {
      if (response.status === 204) return null;
      return response.json();
    }
    const text = await response.text();
    if ((response.status === 429 || response.status >= 500) && attempt < 4) {
      const retryAfter = Number(response.headers.get('retry-after') ?? 0);
      await new Promise((resolve) => setTimeout(resolve,