{
  "schema": "atto.opaque-newtypes-bounds-const-generics.v1",
  "version": 1,
  "status": "TARGET_NOT_EXECUTED",
  "owner": "atto-lang/atto-spec",
  "evidence_policy": "Host/reference checks and fixture presence never certify guest/backend parity; require exact-head typecheck, emitted guest execution and layout/ABI evidence.",
  "rules": {
    "newtype": "fully qualified nominal declaration identity differs from base and every other declaration; no implicit conversion",
    "construction": "checked try_from returns Result; from_const allowed only on exact statically provable value; no unchecked cast or raw publication",
    "ranges": "closed signed-i64 intervals with exact-integer validation, no binary64 mediation, contradictions or unsolved where clauses",
    "dimensions": "typed compile-time usize arguments, checked arithmetic, const-value specialization, profile-governed finite allocation",
    "representation": "eligible scalar layout equals base size/alignment with no per-value metadata; type identity survives IR and external boundaries",
    "incompatibility": "different nominal type or evaluated dimensions are not assignable even with the same byte representation"
  },
  "reference_profile": {
    "signed_integer_bits": 64,
    "usize_bits": 64,
    "max_elements": "1048576",
    "note": "Host model budget only, not a universal backend storage guarantee"
  },
  "nominal_cases": [
    {
      "id": "same-base-distinct-names",
      "left": "pkg/UserId:i64",
      "right": "pkg/OrderId:i64",
      "compatible": false
    },
