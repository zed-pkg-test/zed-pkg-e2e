# Actual source-to-native compilation with deterministic seeded numeric cases.
# Identical .atto text must emit byte-for-byte identical C++ in distinct paths.
if(NOT DEFINED ROOT OR NOT DEFINED FORGE OR NOT DEFINED CXX OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "missing compiler differential test arguments")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(guest_flags)
if(SANITIZERS)
  list(APPEND guest_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
function(check_case tag expr expected)
  set(src "${OUT_DIR}/diff_${tag}.atto")
  set(cpp_a "${OUT_DIR}/diff_${tag}_a.cpp")
  set(cpp_b "${OUT_DIR}/diff_${tag}_b.cpp")
  set(binary "${OUT_DIR}/diff_${tag}")
  file(WRITE "${src}" "pub fnc main(): int { return ${expr}; }\n")
  execute_process(COMMAND "${FORGE}" "${src}" -o "${cpp_a}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${tag}: first compile rejected: ${err}")
  endif()
  execute_process(COMMAND "${FORGE}" "${src}" -o "${cpp_b}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${tag}: second compile rejected: ${err}")
  endif()
  file(SHA256 "${cpp_a}" hash_a)
  file(SHA256 "${cpp_b}" hash_b)
  if(NOT "${hash_a}" STREQUAL "${hash_b}")
    message(FATAL_ERROR "${tag}: non-deterministic emitted C++")
  endif()
  file(READ "${cpp_a}" generated)
  string(FIND "${generated}" "${src}" leaked_path)
  if(NOT "${leaked_path}" EQUAL -1)
    message(FATAL_ERROR "${tag}: generated code leaked source path")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror
    ${guest_flags} "-I${ROOT}/include" "${cpp_a}" -o "${binary}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${tag}: generated native guest failed build: ${err}")
  endif()
  execute_process(COMMAND "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0" OR NOT "${out}" STREQUAL "${expected}\n"
     OR NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "${tag}: execution mismatch rc=[${rc}] out=[${out}] err=[${err}]")
  endif()
endfunction()
foreach(i RANGE 0 47)
  math(EXPR a "(${i} * 17) % 257 - 128")
  math(EXPR b "(${i} * 53) % 127 - 63")
  math(EXPR c "(${i} * 29) % 31 - 15")
  math(EXPR expected "(${a}) + ((${b}) * (${c}))")
  check_case("${i}" "(${a}) + (${b}) * (${c})" "${expected}")
endforeach()
