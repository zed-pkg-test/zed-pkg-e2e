# Genuine source -> Forge parser -> generated C++ -> native guest.
# CMake builds both GCC/Clang and sanitizer variants through the existing CI.
if(NOT DEFINED ROOT OR NOT DEFINED CXX OR NOT DEFINED FORGE OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "Missing compiler guest inputs")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(sources "${ROOT}/fixtures/pointer-local-v1")
set(flags)
if(SANITIZERS)
  list(APPEND flags -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
foreach(id IN ITEMS PRL-001 PRL-002)
  set(file "${sources}/${id}.atto")
  execute_process(COMMAND git hash-object "${file}"
    RESULT_VARIABLE code OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Git hash-object unavailable for ${id}: ${diagnostic}")
  endif()
  if(id STREQUAL "PRL-001")
    set(expected "6056400afa8d7b9b71f29be5ca4cfb15240a59b3")
  else()
    set(expected "8fa66e68b386c2c6d1f2b15b9399e70a116c0828")
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${id}: canonical fixture Git blob mismatch")
  endif()
endforeach()

function(compile_and_execute tag expected)
  set(src "${sources}/${tag}.atto")
  set(cpp "${OUT_DIR}/${tag}.cpp")
  set(binary "${OUT_DIR}/${tag}.guest")
  file(REMOVE "${cpp}" "${cpp}.part")
  execute_process(COMMAND "${FORGE}" "${src}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${cpp}")
    message(FATAL_ERROR "${tag}: real Atto Forge compilation failed: ${rc}: ${err}")
  endif()
  execute_process(COMMAND "${FORGE}" --check "${src}"
    RESULT_VARIABLE check_rc OUTPUT_VARIABLE check_out ERROR_VARIABLE check_err)
  if(NOT check_rc EQUAL 0 OR NOT check_out STREQUAL "")
    message(FATAL_ERROR "${tag}: admission --check failed: ${check_err}")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -O1 -g -Wall -Wextra
      -Werror -pedantic ${flags} "-I${ROOT}/include"
      "${cpp}" -o "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${tag}: guest C++ failed build: ${err}")
  endif()
  execute_process(COMMAND "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT out STREQUAL "${expected}\n" OR NOT err STREQUAL "")
    message(FATAL_ERROR "${tag}: guest rc=[${rc}] out=[${out}] err=[${err}]; expected scalar ${expected}")
  endif()
endfunction()
compile_and_execute("PRL-001" "42")
compile_and_execute("PRL-002" "42")
compile_and_execute("all-bang" "42")
compile_and_execute("alternate-13" "13")
file(SHA256 "${OUT_DIR}/PRL-001.cpp" rt_native_sha256)
file(SHA256 "${OUT_DIR}/PRL-002.cpp" bang_native_sha256)
if(NOT rt_native_sha256 STREQUAL bang_native_sha256)
  message(FATAL_ERROR "rt and bang aliases emitted different native code")
endif()

file(GLOB rejected LIST_DIRECTORIES false "${sources}/negative/*.atto")
list(LENGTH rejected count)
if(NOT count EQUAL 24)
  message(FATAL_ERROR "Expected exactly 24 negative Atto fixtures; found ${count}")
endif()
foreach(src IN LISTS rejected)
  get_filename_component(tag "${src}" NAME_WE)
  file(READ "${src}" content)
  string(REGEX MATCH "^// expect-error: ([A-Z_]+)" header "${content}")
  set(want "${CMAKE_MATCH_1}")
  if(NOT want STREQUAL "E_POINTER_PROFILE" AND
     NOT want STREQUAL "E_PARSE_LEXICAL")
    message(FATAL_ERROR "${tag}: invalid expected compiler diagnostic")
  endif()
  set(fresh "${OUT_DIR}/rejected_${tag}_new.cpp")
  file(REMOVE "${fresh}" "${fresh}.part")
  execute_process(COMMAND "${FORGE}" "${src}" -o "${fresh}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 2 OR EXISTS "${fresh}" OR EXISTS "${fresh}.part" OR
     NOT out STREQUAL "" OR NOT err MATCHES "^${want} byte=")
    message(FATAL_ERROR "${tag}: rejected source created output, rc=${rc} err=${err}")
  endif()
  set(existing "${OUT_DIR}/rejected_${tag}_existing.cpp")
  set(sentinel "USER DATA MUST SURVIVE REJECTED SOURCE: ${tag}\n")
  file(WRITE "${existing}" "${sentinel}")
  execute_process(COMMAND "${FORGE}" "${src}" -o "${existing}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT EXISTS "${existing}" OR EXISTS "${existing}.part")
    message(FATAL_ERROR "${tag}: rejected source removed existing output")
  endif()
  file(READ "${existing}" after)
  if(NOT rc EQUAL 2 OR NOT after STREQUAL sentinel OR
     NOT out STREQUAL "" OR NOT err MATCHES "^${want} byte=")
    message(FATAL_ERROR "${tag}: rejected source modified existing output, rc=${rc} err=${err}")
  endif()
endforeach()
message(STATUS "FORGE_POINTER_NATIVE_GUESTS=4; POINTER_NEGATIVE_NO_ARTIFACT=24; REJECTED_EXISTING_OUTPUT_PRESERVED=24")