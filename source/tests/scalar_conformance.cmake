# Independently check source-to-compiled-native executable guest behavior.
# Stage-0 restricted .atto parser/emitter; no Python.
if(NOT DEFINED ROOT OR NOT DEFINED CXX OR NOT DEFINED FORGE OR NOT DEFINED OUT_DIR)
  message(FATAL_ERROR "missing compiled guest conformance inputs")
endif()
file(MAKE_DIRECTORY "${OUT_DIR}")
set(guest_flags)
if(SANITIZERS)
  list(APPEND guest_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()
function(check_guest tag expression expected_rc expected_out expected_err)
  set(source "${OUT_DIR}/corpus_${tag}.atto")
  set(cpp "${OUT_DIR}/corpus_${tag}.cpp")
  set(binary "${OUT_DIR}/corpus_${tag}")
  file(WRITE "${source}" "pub fnc main(): int { return ${expression}; }\n")
  execute_process(COMMAND "${FORGE}" "${source}" -o "${cpp}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${tag}: source emission failed ${rc}: ${err}")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -Wall -Wextra -Werror
      ${guest_flags} "-I${ROOT}/include" "${cpp}" -o "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "${tag}: native guest build failed: ${err}")
  endif()
  execute_process(COMMAND "${binary}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${expected_rc}" OR
     NOT "${out}" STREQUAL "${expected_out}" OR
     NOT "${err}" STREQUAL "${expected_err}")
    message(FATAL_ERROR
      "${tag}: guest rc=[${rc}] stdout=[${out}] stderr=[${err}]; expected rc=${expected_rc}")
  endif()
endfunction()

check_guest(add "2+3" "0" "5\n" "")
check_guest(sub "2-3" "0" "-1\n" "")
check_guest(mul_negative "-3*7" "0" "-21\n" "")
